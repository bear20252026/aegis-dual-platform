<?xml version="1.0" encoding="utf-8"?>
<!-- AD-095（审计 2026-09-23 清单·A6 批）：parent 换深色基底——原
     Theme.Material.Light 与深色 chrome（状态栏/导航栏 #101827、Compose
     深色玻璃 UI）相悖：Light 基底下窗口背景/对话框/Toast 呈亮色，
     与整体深色视觉割裂。AD-094：颜色字面量迁入 colors.xml 单源。 -->
<resources>
    <style name="Theme.Aegis" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/theme_accent</item>
        <item name="android:navigationBarColor">@color/chrome_status_bar</item>
        <item name="android:statusBarColor">@color/chrome_status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
