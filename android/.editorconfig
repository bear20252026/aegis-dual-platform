# Aegis Android 端代码风格（EditorConfig + ktlint）
# 工具链 P0：ktlint 官方配置 —— Compose 组件函数遵循 JetBrains 规范
# （@Composable 函数 PascalCase 命名），通过 ignore_when_annotated_with 豁免，
# 而非逐个 @Suppress 或改名（改名会破坏 Compose 约定）。

root = true

[*]
charset = utf-8
# R8-CI-09（第八轮审计 2026-10-04）：此处原写 crlf，而仓库 blob 全部是 LF
# （`git ls-files` 实测受管文本 i/lf），即「配置与其管辖对象现状相反」——一旦有人跑
# ktlint --format/spotless 就整树换行重写。第七轮 B4 已为行尾付过一次代价
#（门禁自身把 CRLF 工作副本写成 LF＝「门禁自己污染源文件」）。现与仓库根 .editorconfig
# 及新增的 .gitattributes 同口径。
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# ktlint：忽略带 @Composable 注解的组件函数命名检查（官方 Compose 约定 PascalCase）
ktlint_function_naming_ignore_when_annotated_with = Composable
