<Window x:Class="Aegis.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Aegis" Height="800" Width="1200">
  <!-- 受信 chrome UI（本地 bundled origin——远程页面无 native bridge） -->
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="4">
      <Button x:Name="BackButton" Content="←" Click="Back_Click" Width="32" ToolTip="后退"/>
      <Button x:Name="ForwardButton" Content="→" Click="Forward_Click" Width="32" ToolTip="前进"/>
      <Button x:Name="RefreshButton" Content="⟳" Click="Refresh_Click" Width="32" ToolTip="刷新"/>
      <TextBox x:Name="AddressBar" KeyDown="AddressBar_KeyDown" Margin="4,0" ToolTip="地址栏（导航经 Broker 决策）"/>
    </DockPanel>
    <wv2:WebView2 x:Name="Browser"/>
  </DockPanel>
</Window>
