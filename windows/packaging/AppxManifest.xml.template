<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedCapabilities">
  <!-- Replace Identity Publisher with the production signing identity before release. -->
  <Identity Name="Aegis.Project.AegisWebView" Publisher="CN=Aegis Project" Version="2.1.6.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Aegis WebView</DisplayName>
    <PublisherDisplayName>Aegis Project</PublisherDisplayName>
    <Description>Aegis WebView secure browser</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources><Resource Language="zh-CN" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="AegisWebView" Executable="Aegis.exe" EntryPoint="Windows.FullTrustApplication" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Aegis WebView" Description="Aegis WebView secure browser" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="#101827" />
      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="Aegis.exe" />
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
</Package>
