<UserControl x:Class="Aegis.Windows.Chrome.DateField"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
  <UserControl.Resources>
    <!-- 圆形月份导航钮 -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="15" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 日格 -->
    <Style x:Key="DayCell" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- 日期字段（点击展开日历） -->
    <Button x:Name="FieldButton" Height="34" Click="FieldButton_Click" Cursor="Hand">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="11" Background="{DynamicResource FieldBackgroundBrush}"
                  BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="12,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="📅" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock x:Name="FieldLabel" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="选择日期"/>
      </StackPanel>
    </Button>

    <!-- 自绘月历浮层 -->
    <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=FieldButton}" Placement="Bottom"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border CornerRadius="16" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
              Padding="14" Margin="0,6,18,18" Width="296">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
          <DockPanel>
            <Button Style="{StaticResource NavButton}" Content="‹" DockPanel.Dock="Left" Click="PrevMonth_Click" ToolTip="上个月"/>
            <Button Style="{StaticResource NavButton}" Content="›" DockPanel.Dock="Right" Click="NextMonth_Click" ToolTip="下个月"/>
            <TextBlock x:Name="MonthTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
          </DockPanel>
          <UniformGrid Columns="7" Margin="0,12,0,4">
            <TextBlock Text="一" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="二" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="三" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="四" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="五" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="六" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="日" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
          </UniformGrid>
          <UniformGrid x:Name="DayGrid" Columns="7" Rows="6"/>
          <Button Content="回到今天" Style="{StaticResource NavButton}" Height="30" FontSize="12"
                  Click="Today_Click" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
