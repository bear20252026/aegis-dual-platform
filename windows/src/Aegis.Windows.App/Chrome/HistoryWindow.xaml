<Window x:Class="Aegis.Windows.Chrome.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录" Width="720" Height="520"
        Background="#FF101827" FontFamily="Segoe UI, Microsoft YaHei UI">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Content="清除全部" Click="Clear_Click" Width="88" Height="30"
              Background="#FF7F1D1D" Foreground="White" BorderThickness="0" Cursor="Hand"/>
      <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
               TextChanged="SearchBox_TextChanged"
               ToolTip="全文检索历史（url + 标题）"/>
    </DockPanel>
    <ListBox x:Name="HistoryList" Margin="0,8,0,0" Background="Transparent"
             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,4">
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Url}" Foreground="#FF94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
