<Window x:Class="Aegis.Windows.Chrome.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录" Width="760" Height="560"
        Background="{DynamicResource ChromeBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <!-- 深/浅主题共用色（与主窗口同 key——随设置切换） -->
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FF101827"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB3FFFFFF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8A93A6"/>
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7F1D1D"/>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FF0B57D0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <!-- 头部：搜索 + 日期筛选 + 清除 -->
    <Border DockPanel.Dock="Top" Padding="0,0,0,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="清除全部" Click="Clear_Click" Width="96" Height="32"
                Background="{DynamicResource DangerBrush}" Foreground="White" BorderThickness="0"
                Cursor="Hand" FontSize="12"/>
        <ComboBox DockPanel.Dock="Right" x:Name="DateFilter" Width="150" Height="32" Margin="0,0,10,0"
                  VerticalContentAlignment="Center" SelectionChanged="DateFilter_Changed" ToolTip="按日期筛选"/>
        <Border Background="{DynamicResource FieldBackgroundBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                BorderThickness="1" CornerRadius="16" Height="32">
          <Grid>
            <TextBlock x:Name="SearchHint" Text="搜索历史（地址 / 标题）…" Margin="14,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                       IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" VerticalContentAlignment="Center" Height="30" Margin="8,0"
                     TextChanged="SearchBox_TextChanged"/>
          </Grid>
        </Border>
      </DockPanel>
    </Border>
    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Margin="0,4,0,0" FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"/>

    <!-- 按日期分组的记录列表 -->
    <ListBox x:Name="HistoryList" Margin="0,6,0,0" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource AccentBrush}" CornerRadius="8,8,0,0" Padding="12,7" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding ItemCount}" Foreground="#CCFFFFFF" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" 条" Foreground="#CCFFFFFF" FontSize="11" VerticalAlignment="Center"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource CardBrush}" CornerRadius="0,0,8,8"
                  Margin="0,0,0,1" Padding="12,8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource GhostButton}"
                      Tag="{Binding Id}" Click="Delete_Click" ToolTip="删除这条记录" Margin="6,0,0,0"/>
              <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="11" Width="52" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Host}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>