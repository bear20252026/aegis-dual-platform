<Window x:Class="Aegis.Windows.Chrome.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Aegis.Windows.Chrome"
        Title="历史记录" Width="840" Height="640" MinWidth="680" MinHeight="480"
        Background="{DynamicResource ChromeBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <!-- ═══ iOS 系统色板（浅：#F2F2F7 系 / 深：#1C1C1E 系）——随主题切换 ═══ -->
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FF38383A"/>
    <SolidColorBrush x:Key="SegmentedBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="SegmentedSelectedBrush" Color="#FF5A5A5E"/>
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF98989F"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6C6C70"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#220A84FF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A"/>

    <!-- ═══ 大标题 ═══ -->
    <Style x:Key="LargeTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ═══ iOS 分段控件分段 ═══ -->
    <Style x:Key="Segment" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentedSelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ 按钮 ═══ -->
    <Style x:Key="PageButton" TargetType="Button">
      <Setter Property="MinWidth" Value="32"/><Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="6,0"/>
      <Setter Property="Background" Value="{DynamicResource SegmentedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ 日期分组（iOS 分组列表：小节头 + 圆角卡片 + 发丝分隔线） ═══ -->
    <DataTemplate x:Key="DayGroupTemplate">
      <StackPanel Margin="0,0,0,22">
        <TextBlock Text="{Binding DateLabel}" Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="13" FontWeight="SemiBold" Margin="6,0,0,8"/>
        <Border CornerRadius="14" Background="{DynamicResource CardBrush}">
          <ItemsControl ItemsSource="{Binding Rows}" AlternationCount="100000">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="14,0,14,0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AlternationIndex, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                          <Setter Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid Margin="2,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Host}" Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="10,2,0,0"/>
                    <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" FontSize="11"
                            Tag="{Binding Id}" Click="Delete_Click" ToolTip="删除这条记录" Margin="6,0,0,0"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ 大标题行 ═══ -->
    <DockPanel Grid.Row="0">
      <Button DockPanel.Dock="Right" Content="清除全部" Style="{StaticResource GhostButton}"
              Foreground="{DynamicResource DangerBrush}" Click="Clear_Click" ToolTip="清空全部历史（不可恢复）"/>
      <StackPanel>
        <TextBlock Text="历史记录" Style="{StaticResource LargeTitle}"/>
        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="13" Margin="2,4,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- ═══ 搜索（iOS 搜索栏） ═══ -->
    <Border Grid.Row="1" Height="38" CornerRadius="11" Margin="0,14,0,0"
            Background="{DynamicResource FieldBackgroundBrush}">
      <Grid>
        <StackPanel x:Name="SearchHint" Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="🔍" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Text="搜索历史（地址 / 标题）" Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBox x:Name="SearchBox" Margin="14,0" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                 VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
      </Grid>
    </Border>

    <!-- ═══ 日期筛选：分段控件 + 可展开日历 + 范围 ═══ -->
    <WrapPanel Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center">
      <Border CornerRadius="10" Background="{DynamicResource SegmentedBrush}" Padding="3">
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="ChipAll" Style="{StaticResource Segment}" Content="全部" IsChecked="True"
                        Checked="ChipFilter_Changed" Padding="12,0"/>
          <ToggleButton x:Name="ChipToday" Style="{StaticResource Segment}" Content="今天"
                        Checked="ChipFilter_Changed" Margin="2,0" Padding="12,0"/>
          <ToggleButton x:Name="ChipYesterday" Style="{StaticResource Segment}" Content="昨天"
                        Checked="ChipFilter_Changed" Padding="12,0"/>
          <ToggleButton x:Name="ChipWeek" Style="{StaticResource Segment}" Content="近7天"
                        Checked="ChipFilter_Changed" Margin="2,0" Padding="12,0"/>
          <ToggleButton x:Name="ChipMonth" Style="{StaticResource Segment}" Content="本月"
                        Checked="ChipFilter_Changed" Margin="2,0" Padding="12,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="每页" VerticalAlignment="Center" Margin="16,0,6,0"
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
      <ComboBox x:Name="PageSizeBox" Width="82" Height="30" SelectedIndex="1"
                SelectionChanged="PageSize_Changed" VerticalContentAlignment="Center">
        <ComboBoxItem Content="50 条" Tag="50"/>
        <ComboBoxItem Content="100 条" Tag="100"/>
        <ComboBoxItem Content="200 条" Tag="200"/>
        <ComboBoxItem Content="500 条" Tag="500"/>
      </ComboBox>
      <TextBlock Text="自定义" VerticalAlignment="Center" Margin="16,0,8,0"
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
      <chrome:DateField x:Name="CustomDate" Width="160" PlaceholderText="选择日期"
                        SelectedDateChanged="CustomDate_SelectedDateChanged" ToolTip="展开日历，选择某一天"/>
      <ToggleButton x:Name="ChipRange" Style="{StaticResource Segment}" Content="范围"
                    Checked="ChipFilter_Changed" Unchecked="ChipFilter_Changed" Margin="12,0,0,0" Padding="12,0"
                    ToolTip="按起止日期范围查询"/>
      <StackPanel x:Name="RangePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="10,0,0,0">
        <chrome:DateField x:Name="RangeFrom" Width="140" PlaceholderText="开始日期"
                          SelectedDateChanged="RangeDate_Changed" ToolTip="开始日期"/>
        <TextBlock Text="—" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <chrome:DateField x:Name="RangeTo" Width="140" PlaceholderText="结束日期"
                          SelectedDateChanged="RangeDate_Changed" ToolTip="结束日期"/>
      </StackPanel>
    </WrapPanel>

    <!-- ═══ 分页列表 ═══ -->
    <TextBlock x:Name="EmptyHint" Grid.Row="3" Margin="0,24,0,0" FontSize="14"
               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
    <ListBox x:Name="HistoryList" Grid.Row="3" Margin="0,16,0,0" Background="Transparent"
             BorderThickness="0" ItemTemplate="{StaticResource DayGroupTemplate}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             Focusable="False"/>

    <!-- ═══ 页码导航（上一页/页码/下一页 + 当前页状态） ═══ -->
    <DockPanel Grid.Row="4" Margin="0,10,0,0">
      <TextBlock x:Name="PageStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="PrevPageButton" Content="‹ 上一页" Style="{StaticResource PageButton}"
                Click="PrevPage_Click"/>
        <ItemsControl x:Name="PageButtons">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button x:Name="NextPageButton" Content="下一页 ›" Style="{StaticResource PageButton}"
                Click="NextPage_Click"/>
      </StackPanel>
      <TextBlock Text="每页可在上方设置" DockPanel.Dock="Right" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
    </DockPanel>
  </Grid>
</Window>
