<Window x:Class="Aegis.Windows.Chrome.SourceViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="源码视图" Width="860" Height="600"
        Background="{DynamicResource ChromeBackgroundBrush}" FontFamily="Consolas, Courier New">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" Padding="10,6">
      <TextBlock x:Name="SourceUrl" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                 TextTrimming="CharacterEllipsis"/>
    </Border>
    <!-- CS-359（2026-10-01 审计）：大文本改首屏 256KB 预览 + 加载全部按钮
         （5MB 全量塞非虚拟化 TextBox 即 UI 冻结） -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" Padding="10,6">
      <DockPanel>
        <Button x:Name="LoadAllButton" DockPanel.Dock="Right" Content="加载全部" MinWidth="88" Height="26"
                Click="LoadAll_Click" ToolTip="加载完整源码（大文本排版可能短暂卡顿）"/>
        <TextBlock x:Name="PreviewHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <!-- 大文本性能：禁用撤销栈与自动换行（排版/内存开销主要来源），
         AcceptsTab 关闭以保留键盘导航 -->
    <TextBox x:Name="SourceText" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" Background="Transparent"
             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" IsUndoEnabled="False" UndoLimit="0"
             TextWrapping="NoWrap" AcceptsTab="False"
             ToolTip="全转义纯文本——零脚本执行"/>
  </DockPanel>
</Window>
