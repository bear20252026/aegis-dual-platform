<Window x:Class="Aegis.Windows.Chrome.SourceViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="源码视图" Width="860" Height="600"
        Background="#FF161618" FontFamily="Consolas, Courier New">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FF1F1F23" Padding="10,6">
      <TextBlock x:Name="SourceUrl" Foreground="#FF9CA3AF" FontSize="12"
                 TextTrimming="CharacterEllipsis"/>
    </Border>
    <TextBox x:Name="SourceText" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" Background="Transparent"
             Foreground="#FFD4D4D8" FontSize="12" TextChanged="SourceText_TextChanged"
             ToolTip="全转义纯文本——零脚本执行"/>
  </DockPanel>
</Window>
