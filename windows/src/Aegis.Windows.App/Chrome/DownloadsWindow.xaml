<Window x:Class="Aegis.Windows.Chrome.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载管理" Height="440" Width="580"
        Background="{DynamicResource ChromeBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <!-- UI 现代化批②：圆角玻璃操作钮（📂 emoji → MDL2 字体 glyph）+ iOS 卡片
       行样式 + 本地深浅色板默认（WindowTheme.Apply 按主题覆盖）。
       x:Name/事件处理器与 code-behind 契约不变。 -->
  <Window.Resources>
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF98989F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#220A84FF"/>

    <!-- 圆角玻璃小操作钮（原默认模板方钮 + 📂 emoji 的替代） -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>
  <Grid Margin="14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="2,0,2,10">
      <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="清空列表"
              AutomationProperties.Name="清空已完成的下载条目" Click="ClearList_Click"
              ToolTip="移除已完成/已取消/已中断的条目（不删除文件）"/>
      <TextBlock x:Name="CountText" Text="下载" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
    </DockPanel>
    <ListBox Grid.Row="1" x:Name="DownloadsList" AutomationProperties.Name="下载任务列表" Background="Transparent" BorderThickness="0"
             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border CornerRadius="10" Background="{DynamicResource CardBrush}" Padding="12,10" Margin="0,0,0,8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
              </Grid>
              <ProgressBar Grid.Row="1" Height="4" Margin="0,8,0,6" Minimum="0" Maximum="100"
                           Background="#22FFFFFF" Foreground="#FF0A84FF" BorderThickness="0"
                           Value="{Binding Percent, Mode=OneWay}"/>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Style="{StaticResource LinkButton}" AutomationProperties.Name="打开下载的文件" Click="OpenFile_Click" Margin="4,0,0,0"
                          ToolTip="用系统默认程序打开已下载的文件" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                      <TextBlock Text="打开文件" Margin="5,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource LinkButton}" AutomationProperties.Name="暂停下载" Content="暂停" Click="Pause_Click" Margin="4,0,0,0"/>
                  <Button Style="{StaticResource LinkButton}" AutomationProperties.Name="继续下载" Content="继续" Click="Resume_Click" Margin="4,0,0,0"/>
                  <Button Style="{StaticResource LinkButton}" AutomationProperties.Name="取消下载" Content="取消" Click="Cancel_Click" Margin="4,0,0,0"/>
                  <Button Style="{StaticResource LinkButton}" AutomationProperties.Name="打开下载所在文件夹" Click="ShowInFolder_Click" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                      <TextBlock Text="所在文件夹" Margin="5,0,0,0"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
