<Window x:Class="Aegis.Windows.Chrome.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载管理" Height="420" Width="560"
        Background="#FF101827" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3FFFFFF"/>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="下载（原生 DownloadStarting——进度/暂停/取消）"
               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
    <ListBox Grid.Row="1" x:Name="DownloadsList" Background="Transparent" BorderThickness="0"
             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border CornerRadius="8" Background="#1FFFFFFF" Padding="10,8" Margin="0,0,0,6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
              </Grid>
              <ProgressBar Grid.Row="1" Height="4" Margin="0,6,0,4" Minimum="0" Maximum="100"
                           Background="#22FFFFFF" Foreground="#FF3B82F6" BorderThickness="0"
                           Value="{Binding Percent, Mode=OneWay}"/>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Style="{StaticResource LinkButton}" Content="暂停" Click="Pause_Click" Margin="4,0,0,0"/>
                  <Button Style="{StaticResource LinkButton}" Content="继续" Click="Resume_Click" Margin="4,0,0,0"/>
                  <Button Style="{StaticResource LinkButton}" Content="取消" Click="Cancel_Click" Margin="4,0,0,0"/>
                  <Button Style="{StaticResource LinkButton}" Content="打开文件夹" Click="ShowInFolder_Click" Margin="4,0,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
