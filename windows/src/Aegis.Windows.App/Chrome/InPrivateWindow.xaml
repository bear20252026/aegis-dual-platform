<Window x:Class="Aegis.Windows.Chrome.InPrivateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InPrivate 无痕浏览" Width="1000" Height="700"
        Background="#FF14141A" FontFamily="Segoe UI, Microsoft YaHei UI"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="ChromeB" Color="#FF1A1A22"/>
    <SolidColorBrush x:Key="CardB" Color="#FF23232D"/>
    <SolidColorBrush x:Key="T1" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="T2" Color="#FFB9B9C9"/>
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{StaticResource T1}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="17" Background="#22FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <!-- 标签条 -->
    <Border DockPanel.Dock="Top" Background="{StaticResource ChromeB}" Padding="8,4">
      <DockPanel>
        <Button x:Name="NewTabBtn" DockPanel.Dock="Right" Style="{StaticResource NavBtn}" Content="＋" Click="NewTab_Click" ToolTip="新建标签"/>
        <TextBlock DockPanel.Dock="Left" Text="🕶 InPrivate" Foreground="#FF9AA0FF" Margin="4,0,12,0"
                   VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ListBox x:Name="TabStrip" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                   SelectionChanged="TabStrip_SelectionChanged">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8,8,0,0" Padding="12,6" Margin="0,0,2,0" Background="{StaticResource CardB}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="TabClose_Click" Tag="{Binding TabId}"
                            FontSize="9" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource T2}" Cursor="Hand"/>
                    <TextBlock Text="{Binding Title}" FontSize="12" MaxWidth="160" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource T1}"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- 工具栏 -->
    <Border DockPanel.Dock="Top" Background="#FF14141A" Padding="8,6">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource NavBtn}" Content="←" Click="Back_Click" ToolTip="后退"/>
          <Button Style="{StaticResource NavBtn}" Content="→" Click="Forward_Click" Margin="6,0,0,0" ToolTip="前进"/>
          <Button Style="{StaticResource NavBtn}" Content="⟳" Click="Refresh_Click" Margin="6,0,0,0" ToolTip="刷新"/>
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="关闭" Click="CloseWindow_Click" Height="34" Margin="8,0,0,0"
                Background="#FF7F1D1D" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="12,0"/>
        <Border Margin="10,0,0,0" CornerRadius="17" Background="#FF23232D" Height="34">
          <Grid>
            <TextBlock x:Name="AddressHint" Text="在无痕窗口中搜索或输入网址…" Margin="16,0,0,0"
                       VerticalAlignment="Center" Foreground="{StaticResource T2}" IsHitTestVisible="False"/>
            <TextBox x:Name="AddressBar" BorderThickness="0" Background="Transparent" Margin="14,0"
                     Foreground="{StaticResource T1}" CaretBrush="#FFFFFFFF" VerticalContentAlignment="Center"
                     TextChanged="AddressBar_TextChanged" KeyDown="AddressBar_KeyDown"/>
          </Grid>
        </Border>
      </DockPanel>
    </Border>
    <Grid x:Name="WebViewHost"/>
  </DockPanel>
</Window>
