<Window x:Class="Aegis.Windows.Chrome.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="480" SizeToContent="Height"
        Background="#FF101827" FontFamily="Segoe UI, Microsoft YaHei UI"
        ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock Text="搜索引擎" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <ComboBox x:Name="EngineBox" Height="30" SelectionChanged="EngineBox_SelectionChanged"/>

    <TextBlock Text="历史记录" Foreground="White" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <CheckBox x:Name="HistoryToggle" Content="记录浏览历史" Foreground="#FFB3FFFFFF"
              Checked="HistoryToggle_Changed" Unchecked="HistoryToggle_Changed"/>

    <TextBlock Text="外观主题" Foreground="White" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <ComboBox x:Name="ThemeBox" Height="30" SelectionChanged="ThemeBox_SelectionChanged">
      <ComboBoxItem Content="深色"/>
      <ComboBoxItem Content="浅色"/>
    </ComboBox>

    <TextBlock Text="威胁黑名单订阅源" Foreground="White" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <TextBox x:Name="ThreatFeedBox" Height="30" VerticalContentAlignment="Center"
             LostFocus="ThreatFeedBox_LostFocus"
             ToolTip="仅支持 https://（明文源可被投毒——拒绝）"/>
    <TextBlock x:Name="ThreatFeedHint" Foreground="#FF94A3B8" FontSize="11" Margin="0,4,0,0"
               TextWrapping="Wrap"
               Text="每行一个域名的纯文本黑名单；生效于下次启动（导航与子资源拦截）。"/>

    <TextBlock Text="紧急终止开关" Foreground="White" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <Button x:Name="KillSwitchButton" Content="触发紧急终止（冻结全部导航与下载）"
            Height="32" Background="#FF7F1D1D" Foreground="White" BorderThickness="0"
            Cursor="Hand" Click="KillSwitch_Click"/>
    <TextBlock x:Name="KillSwitchState" Foreground="#FFFCA5A5" FontSize="11" Margin="0,4,0,0"
               Text="触发后需重启应用恢复浏览。"/>

    <Button Content="完成" Height="32" Margin="0,16,0,0" Background="#FF1F2937"
            Foreground="White" BorderThickness="0" Cursor="Hand" Click="Done_Click"/>
  </StackPanel>
</Window>
