<Window x:Class="Aegis.Windows.Chrome.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="520" SizeToContent="Height" MaxHeight="680"
        Background="{DynamicResource ChromeBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <!-- UI 现代化批②：iOS 卡片分组 + 全套深色控件（ChromeComboBox/DarkCheck/
       DarkInput/SolidButton——原原生白底 Win32 控件与深色窗口割裂）。
       色板默认深色值，WindowTheme.Apply 按主题覆盖（DynamicResource 即时刷）。
       x:Name/事件处理器与 code-behind 契约不变。 -->
  <Window.Resources>
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="SegmentedBrush" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="FieldBorderFocusedBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF98989F"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6C6C70"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#220A84FF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A"/>

    <!-- 分组卡片（iOS 设置列表质感） -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="GroupTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,0,0,8"/>
    </Style>
  </Window.Resources>
  <!-- CS-289：固定宽度内容在小屏/高 DPI 下溢出窗口——ScrollViewer 兜底可滚动 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20,18">

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="搜索引擎" Style="{StaticResource GroupTitle}"/>
        <ComboBox x:Name="EngineBox" Height="34" Style="{DynamicResource ChromeComboBox}"
                  AutomationProperties.Name="搜索引擎选择" SelectionChanged="EngineBox_SelectionChanged"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="历史记录" Style="{StaticResource GroupTitle}"/>
        <CheckBox x:Name="HistoryToggle" Style="{DynamicResource DarkCheck}"
                  AutomationProperties.Name="记录浏览历史开关" Content="记录浏览历史"
                  Checked="HistoryToggle_Changed" Unchecked="HistoryToggle_Changed"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="外观主题" Style="{StaticResource GroupTitle}"/>
        <ComboBox x:Name="ThemeBox" Height="34" Style="{DynamicResource ChromeComboBox}"
                  AutomationProperties.Name="外观主题选择" SelectionChanged="ThemeBox_SelectionChanged">
          <ComboBoxItem Content="深色"/>
          <ComboBoxItem Content="浅色"/>
        </ComboBox>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="后台标签睡眠" Style="{StaticResource GroupTitle}"/>
        <ComboBox x:Name="SleepCombo" Height="34" Style="{DynamicResource ChromeComboBox}"
                  AutomationProperties.Name="后台标签睡眠时长选择" SelectionChanged="SleepCombo_Changed">
          <ComboBoxItem Content="关闭"/><ComboBoxItem Content="15 分钟"/><ComboBoxItem Content="30 分钟"/><ComboBoxItem Content="60 分钟"/>
        </ComboBox>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="跟踪防护" Style="{StaticResource GroupTitle}"/>
        <ComboBox x:Name="ProtectionCombo" Height="34" Style="{DynamicResource ChromeComboBox}"
                  AutomationProperties.Name="跟踪防护级别选择" SelectionChanged="ProtectionCombo_Changed">
          <ComboBoxItem Content="基础（仅威胁黑名单）"/><ComboBoxItem Content="均衡（+已知跟踪器）"/><ComboBoxItem Content="严格（+拦截第三方脚本/图片）"/>
        </ComboBox>
        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                   Text="严格模式可能影响部分站点加载——建议默认均衡。"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="加密与安全" Style="{StaticResource GroupTitle}"/>
        <CheckBox x:Name="HttpsCheck" Style="{DynamicResource DarkCheck}" AutomationProperties.Name="HTTPS-only 开关"
                  Content="HTTPS-only（http 自动升级 https）"
                  Checked="Privacy_Changed" Unchecked="Privacy_Changed"/>
        <CheckBox x:Name="DnsCheck" Style="{DynamicResource DarkCheck}" AutomationProperties.Name="安全 DNS 开关"
                  Content="安全 DNS（DoH，重启生效）" Margin="0,12,0,0"
                  Checked="Privacy_Changed" Unchecked="Privacy_Changed"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="威胁黑名单订阅源" Style="{StaticResource GroupTitle}"/>
        <TextBox x:Name="ThreatFeedBox" Style="{DynamicResource DarkInput}"
                 AutomationProperties.Name="威胁黑名单订阅源地址输入"
                 LostFocus="ThreatFeedBox_LostFocus"
                 ToolTip="仅支持 https://（明文源可被投毒——拒绝）"/>
        <TextBlock x:Name="ThreatFeedHint" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="2,8,0,0"
                   TextWrapping="Wrap"
                   Text="每行一个域名的纯文本黑名单；生效于下次启动（导航与子资源拦截）。"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="紧急终止开关" Style="{StaticResource GroupTitle}"/>
        <Button x:Name="KillSwitchButton" AutomationProperties.Name="触发紧急终止按钮"
                Content="触发紧急终止（冻结全部导航与下载）"
                Style="{DynamicResource DangerSolidButton}"
                Cursor="Hand" Click="KillSwitch_Click"/>
        <TextBlock x:Name="KillSwitchState" Foreground="#FFFCA5A5" FontSize="11" Margin="2,8,0,0"
                   Text="触发后需重启应用恢复浏览。"/>
      </StackPanel>
    </Border>

    <Button AutomationProperties.Name="完成设置" Content="完成" Style="{DynamicResource SolidButton}"
            HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="Done_Click"/>
  </StackPanel>
  </ScrollViewer>
</Window>
