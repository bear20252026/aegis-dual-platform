<Window x:Class="Aegis.Windows.Chrome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aegis" Height="800" Width="1200"
        Background="#FF101827" FontFamily="Segoe UI, Microsoft YaHei UI"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <!-- 色板与 Android UiColors.kt 一一对应（ChromeBackground/ButtonOverlay/
         FieldBackground/FieldBorder/TextSecondary——双端同值的跨端契约） -->
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FF101827"/>
    <SolidColorBrush x:Key="ButtonOverlayBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ButtonOverlayHoverBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="ButtonOverlayPressedBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1B2537"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#223B82F6"/>
    <SolidColorBrush x:Key="FieldBorderFocusedBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>

    <!-- 圆形玻璃导航钮（对齐 Android ChromeIconButton） -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="18" Background="{DynamicResource ButtonOverlayBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonOverlayHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonOverlayPressedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 胶囊内嵌「打开」钮（白底黑字——Geist 式高对比，对齐首页搜索按钮） -->
    <Style x:Key="OpenButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FF0B1220"/>
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="14" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFE2E8F0"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFCBD5E1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 书签栏 chips（Apple 圆角）：SegmentedBrush 栏之上的悬浮式胶囊按钮 -->
    <Style x:Key="BookmarkBarButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="9" Background="Transparent"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonOverlayHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonOverlayPressedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- 受信 chrome UI（本地固定 origin——远程页面无 native bridge——ADR-003） -->
  <DockPanel>
    <!-- M1-T1 原生标签条（ADR-009 D2：chrome 与页面 DOM 彻底隔离——
         标签条不再是注入 JS；点击切换/✕ 关闭/＋ 新建，全部原生控件；
         切换经 TabStrip_PreviewMouseLeftButtonDown 显式命中 + SelectionChanged 兜底） -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBackgroundBrush}" Padding="8,4">
      <DockPanel>
        <Button x:Name="NewTabButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                Content="＋" Click="NewTab_Click" ToolTip="新建标签（Ctrl+T）"/>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ListBox x:Name="TabStrip" SelectionMode="Single" Background="Transparent"
                   BorderThickness="0" SelectionChanged="TabStrip_SelectionChanged"
                   ContextMenuOpening="TabStrip_ContextMenuOpening" PreviewMouseDown="TabStrip_PreviewMouseDown"
                   PreviewMouseLeftButtonDown="TabStrip_PreviewMouseLeftButtonDown"
                   AllowDrop="True" PreviewMouseMove="TabStrip_PreviewMouseMove"
                   Drop="TabStrip_Drop" DragOver="TabStrip_DragOver">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Chip" CornerRadius="8,8,0,0" Margin="0,0,0,0"
                              Padding="12,6" BorderThickness="1,1,1,0"
                              BorderBrush="Transparent"
                              Background="{DynamicResource ChromeBackgroundBrush}">
                        <DockPanel>
                          <Button x:Name="TabClose" DockPanel.Dock="Right" Content="✕" Click="TabClose_Click"
                                  Tag="{Binding TabId}" Focusable="False" Cursor="Hand"
                                  FontSize="10" Margin="10,0,0,0" Padding="2,0"
                                  Background="Transparent" BorderThickness="0"
                                  ToolTip="关闭标签（Ctrl+W）" Visibility="Collapsed">
                            <Button.Style>
                              <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                      <Border Background="Transparent" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                  </Trigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse Fill="#FF3B82F6"/>
                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                              <Image.Style>
                                <Style TargetType="Image">
                                  <Setter Property="Visibility" Value="Visible"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Image.Style>
                            </Image>
                          </Grid>
                          <TextBlock x:Name="SleepMark" DockPanel.Dock="Left" Text="💤" FontSize="10"
                                     Margin="0,0,5,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                          <TextBlock x:Name="TabTitle" Text="{Binding Title}" FontSize="12" MaxWidth="150"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </DockPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ChromeBackgroundBrush}"/>
                          <Setter TargetName="Chip" Property="BorderBrush" Value="#22FFFFFF"/>
                          <Setter TargetName="TabTitle" Property="Foreground" Value="#FFFFFFFF"/>
                          <Setter TargetName="TabClose" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ButtonOverlayHoverBrush}"/>
                          <Setter TargetName="TabTitle" Property="Foreground" Value="#FFFFFFFF"/>
                          <Setter TargetName="TabClose" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                          <Setter TargetName="TabClose" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                          <Setter TargetName="SleepMark" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBackgroundBrush}" Padding="8,6">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BackButton" Style="{StaticResource NavButton}" Content="←" Click="Back_Click" ToolTip="后退"/>
          <Button x:Name="ForwardButton" Style="{StaticResource NavButton}" Content="→" Click="Forward_Click" Margin="6,0,0,0" ToolTip="前进"/>
          <Button x:Name="RefreshButton" Style="{StaticResource NavButton}" Content="⟳" Click="Refresh_Click" Margin="6,0,0,0" ToolTip="刷新"/>
          <Button x:Name="StopButton" Style="{StaticResource NavButton}" Content="■" Click="Stop_Click" Margin="6,0,0,0" ToolTip="停止"/>
          <Button x:Name="HomeButton" Style="{StaticResource NavButton}" Content="⌂" Click="Home_Click" Margin="6,0,0,0" ToolTip="主页（新标签页）"/>
        </StackPanel>
        <!-- M2 数据闭环工具组：搜索引擎切换 / 收藏☆ / 历史记录 -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
          <ComboBox x:Name="EngineCombo" Width="120" Height="32" VerticalAlignment="Center" FontSize="12"
                    SelectionChanged="Engine_SelectionChanged" ToolTip="搜索引擎"/>
          <Button x:Name="StarButton" Style="{StaticResource NavButton}" Content="☆"
                  Click="Star_Click" Margin="6,0,0,0" ToolTip="收藏当前页"/>
          <Button x:Name="DownloadsButton" Style="{StaticResource NavButton}" Content="⤓"
                  Click="Downloads_Click" Margin="6,0,0,0" ToolTip="下载管理"/>
          <Button x:Name="BookmarkManagerButton" Style="{StaticResource NavButton}" Content="☆"
                  Click="BookmarkManager_Click" Margin="6,0,0,0" ToolTip="书签管理"/>
          <Button x:Name="HistoryButton" Style="{StaticResource NavButton}" Content="历"
                  Click="History_Click" Margin="6,0,0,0" ToolTip="历史记录"/>
          <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Content="⚙"
                  Click="Settings_Click" Margin="6,0,0,0" ToolTip="设置"/>
          <!-- Edge 风格个人资料圆钮（占位——无账号体系，点击聚焦地址栏） -->
          <Button x:Name="ProfileButton" Style="{StaticResource NavButton}" Content="◐"
                  Click="Profile_Click" Margin="6,0,0,0" ToolTip="个人资料"/>
          <Button x:Name="InPrivateButton" Style="{StaticResource NavButton}" Content="🕶"
                  Click="InPrivate_Click" Margin="6,0,0,0" ToolTip="InPrivate 无痕窗口"/>
        </StackPanel>
        <!-- 胶囊地址栏：深色玻璃 + 聚焦描边 + 占位符 + 内嵌「打开」 -->
        <Border x:Name="AddressPill" Margin="10,0,0,0" CornerRadius="18"
                Background="{DynamicResource FieldBackgroundBrush}" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
              <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderFocusedBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="14,0,4,0">
              <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=AddressPill}"
                     Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                        Padding="6" Margin="0,6,0,0" MinWidth="420" MaxWidth="560" MaxHeight="320">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.35"/>
                  </Border.Effect>
                  <ListBox x:Name="SuggestionList" Background="Transparent" BorderThickness="0"
                           PreviewKeyDown="SuggestionList_KeyDown">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="4,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                          <TextBlock Grid.Column="1" Text="{Binding Kind}" Margin="10,0,0,0"
                                     Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </Popup>
              <TextBlock x:Name="AddressHint" Text="搜索网页或输入网址" VerticalAlignment="Center" 
                         Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>
              <TextBox x:Name="AddressBar" BorderThickness="0" Background="Transparent"
                       Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="#FFFFFFFF"
                       VerticalAlignment="Center" VerticalContentAlignment="Center" Height="30"
                       ToolTip="地址栏（搜索词自动拼引擎；导航经 Broker 决策——真实取消）"
                       TextChanged="AddressBar_TextChanged" KeyDown="AddressBar_KeyDown"
                       GotKeyboardFocus="AddressBar_GotKeyboardFocus"/>
            </Grid>
            <Button x:Name="OpenButton" Grid.Column="1" Style="{StaticResource OpenButton}"
                    Content="打开" Click="Open_Click" ToolTip="导航到地址栏输入"/>
          </Grid>
        </Border>
      </DockPanel>
    </Border>
    <!-- 阶段 C 错误页（导航失败——NavigationCompleted WebErrorStatus——安全错误可见） -->
    <Border x:Name="ErrorPagePanel" DockPanel.Dock="Top" Background="#FF2A1215" Padding="12,8"
            Visibility="Collapsed">
      <TextBlock x:Name="ErrorPage" Foreground="#FFFCA5A5" TextWrapping="Wrap"/>
    </Border>
    <!-- M1-T2 加载指示（WebView2 不暴露页面加载进度——不定态细条，修复
         Python/Android「无加载反馈」审计缺陷的可观测部分） -->
    <ProgressBar x:Name="LoadingBar" DockPanel.Dock="Top" Height="2" IsIndeterminate="True"
                 Background="Transparent" Foreground="#FF3B82F6" BorderThickness="0"
                 Visibility="Collapsed"/>
    <!-- M2 操作反馈条（收藏等——用户可见，2.5s 自动隐藏，不静默） -->
    <Border x:Name="FeedbackBar" DockPanel.Dock="Top" Background="#FF0F2A1B" Padding="12,8"
            Visibility="Collapsed">
      <TextBlock x:Name="FeedbackText" Foreground="#FF86EFAC" TextWrapping="Wrap"/>
    </Border>
    <Grid>
      <!-- M1-T1：每标签一 WebView2 实例（TabRuntime 创建/挂接）——切换即可见性
           切换，页面状态/滚动/表单天然保留（ADR-009 D2） -->
      <!-- ═══ 书签栏 ═══ -->
      <Border x:Name="BookmarkBar" Grid.Row="0" Grid.RowSpan="2" CornerRadius="10" Margin="0,4,0,0" Padding="6,4"
              Background="{DynamicResource SegmentedBrush}" Visibility="Collapsed" VerticalAlignment="Top">
        <ItemsControl x:Name="BookmarkBarItems">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding}" Click="BookmarkBarItem_Click" Margin="2,0"
                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Padding="6,3"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Grid x:Name="WebViewHost"/>
      <!-- P0 页内查找条 -->
      <Border x:Name="FindBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
              CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
              Padding="10,6" Visibility="Collapsed" Panel.ZIndex="8">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="FindBox" Width="200" Height="28" VerticalContentAlignment="Center"
                   FontSize="12" BorderThickness="0"
                   Background="{DynamicResource FieldBackgroundBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}" TextChanged="FindBox_TextChanged"/>
          <TextBlock x:Name="FindCount" VerticalAlignment="Center" Margin="8,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
          <Button Content="▲" Tag="b" Click="Find_Executed" Width="28" Height="28" Cursor="Hand"
                  Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                  ToolTip="上一个"/>
          <Button Content="▼" Tag="f" Click="Find_Executed" Width="28" Height="28" Cursor="Hand"
                  Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                  ToolTip="下一个"/>
          <Button Content="✕" Click="CloseFind_Click" Width="28" Height="28" Cursor="Hand"
                  Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0"
                  ToolTip="关闭（Esc）"/>
        </StackPanel>
      </Border>
      <!-- 全窗口受信模态遮罩：拦截底层点击；只展示 Rust 核心给出的最小审批字段。 -->
      <Grid x:Name="ApprovalOverlay" Visibility="Collapsed" Panel.ZIndex="10" Background="#99101827">
        <Border x:Name="ApprovalPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440"
                Padding="20" Background="#FF1B2537" BorderBrush="#66FFFFFF" BorderThickness="1"
                CornerRadius="12">
          <StackPanel>
            <TextBlock Text="需要确认的导航" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,0,0,12"/>
            <TextBlock Text="来源" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            <TextBlock x:Name="ApprovalOrigin" TextWrapping="Wrap" Foreground="#B3FFFFFF" Margin="0,0,0,8"/>
            <TextBlock Text="路径与查询" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            <TextBlock x:Name="ApprovalPath" TextWrapping="Wrap" Foreground="#B3FFFFFF" Margin="0,0,0,8"/>
            <TextBlock Text="权限范围" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            <TextBlock x:Name="ApprovalScope" TextWrapping="Wrap" Foreground="#B3FFFFFF" Margin="0,0,0,8"/>
            <TextBlock x:Name="ApprovalExpiry" Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="ApprovalDenyButton" Content="拒绝" Click="ApprovalDeny_Click" MinWidth="88"
                      Margin="0,0,8,0" Style="{StaticResource NavButton}" Width="Auto" Height="32" FontSize="13"/>
              <Button Content="批准并继续" Click="ApprovalAllow_Click" MinWidth="112" Style="{StaticResource OpenButton}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
