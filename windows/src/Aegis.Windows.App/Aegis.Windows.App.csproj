<Project Sdk="Microsoft.NET.Sdk">
  <!-- CS-415（2026-10-02 审计）：TargetFramework/Nullable/
       RestorePackagesWithLockFile（含 SP-177/SP-220 注释）与
       TreatWarningsAsErrors 已单源化到 windows/Directory.Build.props；
       本工程差异项（UseWPF/LangVersion 等）与版本三件套（sync_versions.py
       按本文件正则回写）保留在此 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Aegis.Windows.App</AssemblyName>
    <RootNamespace>Aegis.Windows</RootNamespace>
    <StartupObject>Aegis.Windows.Program</StartupObject>
    <Version>2.2.0-beta.52</Version>
    <AssemblyVersion>2.2.0.52</AssemblyVersion>
    <FileVersion>2.2.0.52</FileVersion>
    <PackageId>Aegis.Project.AegisWebView</PackageId>
    <Product>Aegis WebView</Product>
    <RequireNativePolicyCore Condition="'$(RequireNativePolicyCore)' == ''">false</RequireNativePolicyCore>
    <NativePolicyCorePath Condition="'$(NativePolicyCorePath)' == ''"></NativePolicyCorePath>
  </PropertyGroup>
  <Target Name="ValidateNativePolicyCore" BeforeTargets="PrepareForBuild"
          Condition="'$(RequireNativePolicyCore)' == 'true'">
    <Error Condition="!Exists('$(NativePolicyCorePath)')"
           Text="RequireNativePolicyCore=true 时必须提供存在的 NativePolicyCorePath。" />
  </Target>
  <!-- AX-05（外部第三轮审计 2026-10-11，第九轮 §四）：把「本构建要求原生策略核心」
       编译进产物，而不是只留一个用户可清除的 HKCU 标记、或一个只在 CI 那步 shell 里
       存在的环境变量。两条分支都必须生成文件——缺文件即编译失败，所以「发布构建忘了
       开开关」不可能静默退化成「产物里根本没有这个判定源」。开发构建仍生成 false
       那份（不要求 ⇒ 走经验证的托管 broker），否则没 DLL 的机器直接编译不起来。
       产物内另留一条可读的 ASCII 姿态串，供发布链在**已发布的 dll** 上验证终物
       （不是验证命令行了什么参数）。 -->
  <Target Name="GenerateNativePolicyCoreBuildMarker" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_NativeCorePosture Condition="'$(RequireNativePolicyCore)' == 'true'">1</_NativeCorePosture>
      <_NativeCorePosture Condition="'$(_NativeCorePosture)' == ''">0</_NativeCorePosture>
      <!-- C# 布尔字面量另走一条属性：MSBuild 的属性展开里没有内联条件表达式，
           首版写的 `$(_NativeCorePosture == '1')` 展开成空串 ⇒ 产物里是
           `RequiredByThisBuild = ;`（CS1525，本机 dotnet build 实测） -->
      <_NativeCoreRequired Condition="'$(RequireNativePolicyCore)' == 'true'">true</_NativeCoreRequired>
      <_NativeCoreRequired Condition="'$(_NativeCoreRequired)' == ''">false</_NativeCoreRequired>
      <_NativeCoreMarkerFile>$(IntermediateOutputPath)generated/NativePolicyCoreBuildMarker.g.cs</_NativeCoreMarkerFile>
    </PropertyGroup>
    <ItemGroup>
      <!-- 每个 Include 值里的分号必须写成 %3B：MSBuild 把裸 `;` 当项分隔符，
           首版就是这么把 `namespace Aegis.Windows.Broker;` 截成半行、
           产物里留下 CS1002（本机 dotnet build 实测） -->
      <_NativeCoreMarkerLines Include="// &lt;auto-generated/&gt; 由 Aegis.Windows.App.csproj 的 GenerateNativePolicyCoreBuildMarker 目标生成。" />
      <_NativeCoreMarkerLines Include="// 唯一读者是 NativePolicyCoreGate.IsRequired；改这里要先改那条判定与它的测试。" />
      <_NativeCoreMarkerLines Include="namespace Aegis.Windows.Broker%3B" />
      <_NativeCoreMarkerLines Include="internal static class NativePolicyCoreBuildMarker" />
      <_NativeCoreMarkerLines Include="{" />
      <_NativeCoreMarkerLines Include="    internal const bool RequiredByThisBuild = $(_NativeCoreRequired)%3B" />
      <_NativeCoreMarkerLines Include="    internal const string BuildPostureMarker = &quot;aegis.build.require-native-policy-core=$(_NativeCorePosture)&quot;%3B" />
      <_NativeCoreMarkerLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_NativeCoreMarkerFile)"
                      Lines="@(_NativeCoreMarkerLines)"
                      Overwrite="true"
                      Encoding="utf-8" />
  </Target>
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)generated/NativePolicyCoreBuildMarker.g.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- WebView2 SDK（阶段 C：WPF + 原生 WebView2——调研交叉比对选型：
         官方支持 + 中文实测性能略胜 + 成熟简单——ADR-001） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- ADR-009 D2：数据层统一 SQLite（标签会话/书签/历史——FTS5 后续里程碑） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- NU1903（GHSA-2m69-gcr7-jv3q）补钉：此前只钉了 core/provider/lib 三件，
         `bundle_e_sqlite3` 由 Microsoft.Data.Sqlite 的传递依赖决定 ⇒ 锁里长期停在被点名的
         2.1.11（第八轮 R8-DEPS-3）。四件一起显式钉住，锁的 SQLitePCLRaw 家族单源归本文件；
         版本下界另有门禁 scripts/check_package_floors.py。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(NativePolicyCorePath)')">
    <None Include="$(NativePolicyCorePath)"
          Link="aegis_policy_core.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <!-- CS-312（2026-09-26 审计）：Contracts/Generated 六个生成契约类生产与
         测试零引用（运行时契约面是 AuthorizedAction/AuditEvent 等手写模型，
         JSON 由 NativePolicyCoreBridge 直接解析）——从编译移除消除死代码/
         崩溃面。文件保留在磁盘：contracts/codegen/generate_csharp.py 再生成
         与 verify_contract_compatibility.py 的文件级校验不受影响；接入真实
         JSON 反序列化面时移除本条即可。 -->
    <Compile Remove="Contracts\Generated\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- M3 新标签页：start.html 跨端单源（shared/shell——ADR-009 D2-3）经
         虚拟主机 ntp.aegis.local 加载；资源映射到输出 ntp/ 目录，
         不暴露文件系统路径。壁纸同在单源 shell/wallpapers 内。
         审计修复：排除 snake.test.js——测试文件不再随包发布到虚拟主机。 -->
    <Content Include="..\..\..\shared\shell\**\*" Exclude="..\..\..\shared\shell\snake.test.js"
             Link="ntp\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- M3 离线几何画板（GeoGebra Math Apps Bundle——117MB 随包；entry 存在时
         才打包，否则几何画板按钮 fail-closed 置灰）。
         SP-145（2026-09-26 审计）：暂存目录从归档栈 legacy/windows-pywebview/
         geogebra 改为 dist/geogebra-cache/——活跃构建不再向"只读归档"写入并
         依赖其路径（与 .github/workflows/release-windows.yml 的 dest-dir 同步）。
         本地开发：把画板包解压到仓库根 dist/geogebra-cache/ 即可参与打包。 -->
    <Content Include="..\..\..\dist\geogebra-cache\**\*"
             Link="geogebra\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always"
             Condition="Exists('..\..\..\dist\geogebra-cache\GeoGebra\HTML5\5.0\GeoGebra.html')" />
  </ItemGroup>
</Project>
