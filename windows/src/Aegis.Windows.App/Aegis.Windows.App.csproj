<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Aegis.Windows.App</AssemblyName>
    <RootNamespace>Aegis.Windows</RootNamespace>
    <StartupObject>Aegis.Windows.Program</StartupObject>
    <Version>2.1.12</Version>
    <AssemblyVersion>2.1.12.0</AssemblyVersion>
    <FileVersion>2.1.12.0</FileVersion>
    <PackageId>Aegis.Project.AegisWebView</PackageId>
    <Product>Aegis WebView</Product>
    <RequireNativePolicyCore Condition="'$(RequireNativePolicyCore)' == ''">false</RequireNativePolicyCore>
    <NativePolicyCorePath Condition="'$(NativePolicyCorePath)' == ''"></NativePolicyCorePath>
  </PropertyGroup>
  <Target Name="ValidateNativePolicyCore" BeforeTargets="PrepareForBuild"
          Condition="'$(RequireNativePolicyCore)' == 'true'">
    <Error Condition="!Exists('$(NativePolicyCorePath)')"
           Text="RequireNativePolicyCore=true 时必须提供存在的 NativePolicyCorePath。" />
  </Target>
  <ItemGroup>
    <!-- WebView2 SDK（阶段 C：WPF + 原生 WebView2——调研交叉比对选型：
         官方支持 + 中文实测性能略胜 + 成熟简单——ADR-001） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(NativePolicyCorePath)')">
    <None Include="$(NativePolicyCorePath)"
          Link="aegis_policy_core.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
