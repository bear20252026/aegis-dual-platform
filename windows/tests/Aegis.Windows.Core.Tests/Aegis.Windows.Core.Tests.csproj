<Project Sdk="Microsoft.NET.Sdk">
  <!-- CS-415（2026-10-02 审计）：TargetFramework/Nullable/
       RestorePackagesWithLockFile（含 SP-177/SP-220 注释）与
       TreatWarningsAsErrors 已单源化到 windows/Directory.Build.props -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Aegis.Windows.App/Aegis.Windows.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- CS-418（2026-10-02 审计）：contracts 向量跨语言消费（C# 侧）——
         url-origin 有效/无效向量复制到输出目录，UrlOriginVectorTests
         逐条断言 UrlSafety/OriginPolicy 判定与向量一致 -->
    <None Include="..\..\..\contracts\vectors\url-origin-valid.json"
          Link="contracts\vectors\url-origin-valid.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\contracts\vectors\url-origin-invalid.json"
          Link="contracts\vectors\url-origin-invalid.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- R9-B45 / 台账 Q59：文本锚剔注释口径单源。跨 Core.Tests/Broker.Tests 两个
         程序集用「链接同一份源文件」共享——新建测试支撑工程会动构建面（工程引用、
         锁文件、发现数下界），链接源码没有这些代价，代价只是路径上溯一层。 -->
    <Compile Include="..\Aegis.Windows.TestSupport\SourceTextAnchors.cs"
             Link="TestSupport\SourceTextAnchors.cs" />
  </ItemGroup>
</Project>
