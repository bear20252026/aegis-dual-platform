{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis ApprovalRequest（原生确认请求）",
  "description": "蓝图阶段 B（contracts 冻结）：高风险副作用需原生确认——绑定 origin/method/path/scope/过期/一次性 nonce（重放拒绝）。",
  "type": "object",
  "required": ["origin", "method", "path", "scope", "expires_at", "nonce"],
  "properties": {
    "origin": { "type": "string", "pattern": "^https?://" },
    "method": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
