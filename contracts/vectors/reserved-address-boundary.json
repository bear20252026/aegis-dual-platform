      "expected": "deny",
      "note": "广播"
    },
    {
      "url": "http://240.0.0.1/",
      "expected": "deny",
      "note": "240/4 保留"
    },
    {
      "url": "http://192.0.2.1/",
      "expected": "deny",
      "note": "TEST-NET-1 文档段"
    },
