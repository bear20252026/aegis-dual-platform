      "version": "2.2.0-beta.",
      "expected": "deny",
      "note": "尾点＝空标识符（PY-279 报的形态）"
    },
    {
      "version": "2.2.0-..",
      "expected": "deny",
      "note": "连续点＝空标识符"
    },
    {
      "version": "2.2.0-a..b",
      "expected": "deny",
      "note": "中间连续点"
    },
    {
      "version": "2.2.0-",
      "expected": "deny",
      "note": "预发布段为空"
    },
    {
      "version": "2.2.0+",
      "expected": "deny",
      "note": "构建段为空"
    },
    {
