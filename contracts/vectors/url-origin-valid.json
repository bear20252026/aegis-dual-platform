{
  "description": "蓝图阶段 B（contracts/vectors）：合法 URL/Origin 测试向量（与 OriginPolicy/safe_url 对齐——http/https 放行）",
  "vectors": [
    {
      "url": "https://a.gov.cn/page",
      "expected": "allow"
    },
    {
      "url": "https://sub.a.gov.cn/path?q=1",
      "expected": "allow"
    },
    {
      "url": "http://example.org/",
      "expected": "allow"
    },
    {
      "url": "HTTPS://EXAMPLE.ORG/PATH",
      "expected": "allow",
      "note": "PY-079 scheme/host 大写归一化"
    },
    {
      "url": "https://example.org:443/",
      "expected": "allow",
      "note": "PY-080 显式默认端口（origin 归一与省略等价）"
    },
    {
      "url": "http://example.org:80/",
      "expected": "allow",
      "note": "PY-080 显式默认端口 http"
    },
    {
      "url": "https://xn--e1afmkfd.xn--p1ai/",
      "expected": "allow",
      "note": "PY-081 punycode（xn-- 在字符白名单内）"
    },
    {
      "url": "http://93.184.216.34/",
      "expected": "allow",
      "note": "PY-081 点分十进制 IP 字面量（合法 host 形态）"
    },
    {
      "url": "http://[::1]/",
      "expected": "allow",
      "note": "R9-B66：IPv6 回环从 invalid 移进来（B8「本机与内网必须能打开」在语法被拒时从未生效）"
    },
    {
      "url": "http://[::1]:9000/api",
      "expected": "allow",
      "note": "R9-B66：带端口 + 路径的 IPv6 字面量"
    },
    {
      "url": "http://[fd00::1]/",
      "expected": "allow",
      "note": "R9-B66：ULA fc00::/7"
    },
    {
      "url": "https://[2001:db8::1]/",
      "expected": "allow",
      "note": "R9-B66：文档段——**语法**收下（策略面在 native-navigation-decision 里判）"
    },
    {
      "url": "http://[::ffff:127.0.0.1]/",
      "expected": "allow",
      "note": "R9-B66：IPv4-mapped 内嵌回环；语法收下，分类必须折回 127/8"
    },
    {
      "url": "http://[::ffff:192.168.1.1]/",
      "expected": "allow",
      "note": "R9-B66：IPv4-mapped 内嵌私网"
    },
    {
      "url": "https://[2001:0DB8::1]/",
      "expected": "allow",
      "note": "R9-B66：大写十六进制——三端都必须按同一地址收下（小写归一）"
    },
    {
      "url": "https://[0:0:0:0:0:ffff:7f00:1]/",
      "expected": "allow",
      "note": "R9-B66：同一回环的第三种拼法（不压缩 + 十六进制尾段）——按文本前缀判的实现在这里必然分叉，所以按字节判"
    },
    {
      "url": "http://[::2]/",
      "expected": "allow",
      "note": "R9-B69（Q64）：v4-compatible 形态的**语法**面——三端都必须收下，分歧在分类层不在这层"
    },
    {
      "url": "https://[::169.254.169.254]/latest",
      "expected": "allow",
      "note": "R9-B69：带点分尾段的 v4-compatible（前置 96 位全零、无 ffff）——R9-B66 修好的点分尾段解析在这里必须同样收下，否则语法层先分叉"
    }
  ]
}
