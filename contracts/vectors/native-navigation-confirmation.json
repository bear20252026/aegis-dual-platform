{
  "protocol": "aegis-native-navigation-confirmation-v3",
  "vectors": [
    {
      "name": "approve_then_consume_once",
      "register_session": true,
      "generation": 0,
      "url": "HTTPS://Example.COM:443/confirm?flow=1#request",
      "scope": "navigation",
      "approve_url": "https://example.com/confirm?flow=1#approve",
      "approve_scope": "navigation",
      "expected_request": "require_confirmation",
      "expected_approve": "allow",
      "expected_consume": "allow",
      "expected_replay_code": "nonce_replay"
    },
    {
      "name": "approval_url_change_revokes_pending_request",
      "register_session": true,
      "generation": 0,
      "url": "https://example.com/confirm?flow=1",
      "scope": "navigation",
      "approve_url": "https://example.com/confirm?flow=2",
      "approve_scope": "navigation",
      "expected_request": "require_confirmation",
      "expected_approve": "deny",
      "expected_approve_code": "approval_binding_mismatch",
      "expected_second_approve_code": "approval_not_pending"
    },
    {
      "name": "explicit_rejection_revokes_pending_request",
      "register_session": true,
      "generation": 0,
      "url": "https://example.com/confirm/reject",
      "scope": "navigation",
      "approve_url": "https://example.com/confirm/reject",
      "approve_scope": "navigation",
      "reject": true,
      "expected_request": "require_confirmation",
      "expected_approve": "deny",
      "expected_approve_code": "approval_not_pending"
    },
    {
      "name": "generation_advance_revokes_pending_request",
      "register_session": true,
      "generation": 0,
      "advance_generation": 1,
      "url": "https://example.com/confirm/stale",
      "scope": "navigation",
      "approve_url": "https://example.com/confirm/stale",
      "approve_scope": "navigation",
      "expected_request": "require_confirmation",
      "expected_approve": "deny",
      "expected_approve_code": "approval_not_pending"
    },
    {
      "name": "unknown_session_never_creates_pending_request",
      "register_session": false,
      "generation": 0,
      "url": "https://example.com/confirm/unknown",
      "scope": "navigation",
      "expected_request": "deny",
      "expected_request_code": "session_not_found"
    }
  ]
}
