# Aegis 架构契约（import-linter 配置，2026-08-15）
# 治理目标（政府级小心严谨）：维持"薄壳入口 → 业务层"单向依赖，
# 防止业务层反向依赖入口/壳（解耦——壳可替换的代码级保证）。
# 工具：import-linter 2.13（官方推荐 + 中文权威 piglei 博客交叉确认）

[importlinter]
# Aegis 用绝对模块名（main_webview/crash_reporter 为顶层脚本，app 为包）；
# 不设 root_package（相对模块名解析仅对单包项目需要）

[importlinter:contract:entry-layers]
name = 分层：入口层 → 业务层，基础设施可被所有层依赖
type = layers
layers =
    main_webview
    app
    crash_reporter

[importlinter:contract:app-independence]
name = app 核心模块相互独立（防止业务模块互相纠缠）
type = independence
modules =
    app.nav_queue
    app.threat_feed
    app.credential_guard
