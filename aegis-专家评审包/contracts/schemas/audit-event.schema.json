{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis AuditEvent（脱敏审计事件）",
  "description": "蓝图阶段 B（contracts 冻结）：审计事件——记录决策与副作用——必须脱敏（不含 token/网页内容/query secret）。",
  "type": "object",
  "required": ["event_id", "timestamp", "decision", "scope", "origin"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "decision": { "type": "string", "enum": ["allow", "deny", "require_confirmation"] },
    "scope": { "type": "string", "minLength": 1 },
    "origin": { "type": "string" },
    "reason": { "type": "string" },
    "tab_id": { "type": "string" }
  },
  "additionalProperties": false
}
