{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis Update Manifest（更新清单——契约统一）",
  "description": "蓝图阶段 B（contracts 冻结）+ P0-04 修复（专家审查）：从 shared/ 迁入 contracts/——signatures[] 数组 + SemVer 字符串（与 update_verifier 契约一致——重复 key_id 只计一次——异常封装 UpdateRejected）。",
  "type": "object",
  "required": ["schema", "product", "version", "channel", "expires_at", "artifacts", "signatures"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "product": { "type": "string", "const": "Aegis" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "channel": { "type": "string", "enum": ["stable", "beta", "nightly"] },
    "expires_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "format", "url", "sha256", "size"],
        "properties": {
          "platform": { "type": "string", "enum": ["windows-x64", "windows-arm64", "android-universal"] },
          "format": { "type": "string", "enum": ["msix", "appinstaller", "apk", "aab"] },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": { "type": "string", "minLength": 1 },
          "sig": { "type": "string", "pattern": "^[A-Za-z0-9+/=]+$" }
        },
        "additionalProperties": false
      },
      "description": "阈值签名数组（多 key——重复 key_id 只计一次——TUF 对齐）"
    }
  },
  "additionalProperties": false
}
